generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vacina {
  id              Int      @id @default(autoincrement())
  nome            String   @unique
  descricao       String?
  doencasEvitadas String?
  ativa           Boolean  @default(true)
}

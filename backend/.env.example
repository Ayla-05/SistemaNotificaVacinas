# backend/.env.example
# Copie para backend/.env e preencha os valores reais.
# NUNCA commite o .env de verdade (já está no .gitignore).

# Porta do servidor Express
PORT=3000

# Origem permitida pelo CORS (frontend em desenvolvimento)
FRONTEND_URL=http://localhost:5173

# Quantos proxies/balanceadores ficam na frente do servidor
# (ex.: 1). Necessário em produção atrás de proxy: sem isso o
# limite de tentativas por IP e a detecção de HTTPS não funcionam.
# Em branco = sem proxy (desenvolvimento).
TRUST_PROXY=

# Em produção (NODE_ENV=production) redireciona HTTP para HTTPS.
# Use "false" só se o HTTPS for resolvido fora da aplicação.
FORCE_HTTPS=true

# Segredo usado para assinar os tokens JWT de acesso (15 min).
# Gere um valor aleatório longo, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Conexão com o PostgreSQL (usada pela API e pelo Prisma para as migrações).
# Para subir um PostgreSQL local de desenvolvimento, na raiz do projeto:
#   docker compose up -d
# e depois, em backend/:  npm run db:migrar
DATABASE_URL="postgresql://notifica:notifica_dev@localhost:5432/notifica_vacinas"

# Máximo de conexões simultâneas com o banco (opcional; padrão 10).
DB_POOL_MAX=10

# Cria o administrador inicial na primeira vez que o servidor
# sobe (só funciona se as DUAS estiverem preenchidas). Deixe
# em branco depois de já ter criado o seu administrador.
ADMIN_EMAIL=
ADMIN_SENHA=

# URL do serviço de OCR (Docling) que lê as carteirinhas enviadas no
# Scan. Ver ocr-service/README.md. Sem ele, o Scan responde que o serviço
# está indisponível e o usuário cadastra a dose manualmente.
OCR_SERVICE_URL=http://localhost:8000

# E-mail usado para ENVIAR as notificações do sistema
# (boas-vindas com código de confirmação, confirmação de
# dose, pendências, lembretes). Precisa ter a verificação
# em duas etapas ativada na conta e usar uma "senha de app"
# (NÃO é a senha normal da conta):
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Provedor do e-mail acima, se não for Gmail (padrão: gmail).
# Valores aceitos pelo Nodemailer: "yahoo", "outlook365",
# "hotmail", entre outros nomes reconhecidos nativamente.
EMAIL_SERVICE=gmail

# Nome/e-mail exibido como remetente (opcional).
# Padrão: "Notifica Vacinas <EMAIL_USER>"
EMAIL_FROM=

# Expressão cron da verificação diária de pendências/agendamentos.
# Padrão: todo dia às 8h. Ex. para testar a cada 5 minutos: "*/5 * * * *"
NOTIFICACAO_CRON=0 8 * * *

# SMS ainda não tem provedor configurado (ver smsService.ts) -
# nenhuma variável necessária por enquanto.

# Quantos dias antes da data prevista de uma dose o sistema avisa por e-mail
# (uma vez por dose). Padrão: 7.
AVISO_DOSE_DIAS=7

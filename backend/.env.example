# backend/.env.example
# Copie para backend/.env e preencha os valores reais.
# NUNCA commite o .env de verdade (já está no .gitignore).

# Porta do servidor Express
PORT=3000

# Origem permitida pelo CORS (frontend em desenvolvimento)
FRONTEND_URL=http://localhost:5173

# Segredo usado para assinar os tokens JWT de sessão.
# Gere um valor aleatório longo, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Usado pelo Prisma (schema.prisma) - caminho do banco SQLite
DATABASE_URL="file:./vacinas.db"

# Cria o administrador inicial na primeira vez que o servidor
# sobe (só funciona se as DUAS estiverem preenchidas). Deixe
# em branco depois de já ter criado o seu administrador.
ADMIN_EMAIL=
ADMIN_SENHA=

# Chave da API da Anthropic, usada pelo Claude Vision
# para ler as carteirinhas de vacinação enviadas no Scan.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ==================================================
# E-MAIL (envia boas-vindas com código de confirmação,
# confirmação de dose, pendências, lembretes)
# ==================================================
#
# OPÇÃO 1 (recomendada) — Resend: só precisa de uma API
# key, sem senha de app, sem verificação em duas etapas.
# Grátis até 100 e-mails/dia. Crie uma conta e gere a
# chave em https://resend.com/api-keys
RESEND_API_KEY=
#
# OPÇÃO 2 — SMTP de um provedor comum (Gmail, Yahoo, etc).
# Só é usada se RESEND_API_KEY estiver vazia. Precisa ter
# a verificação em duas etapas ativada na conta e usar uma
# "senha de app" (NÃO é a senha normal da conta):
#  - Gmail:   https://myaccount.google.com/apppasswords
#  - Yahoo:   https://login.yahoo.com/account/security -> "Gerar senha de app"
#  - Outlook: https://account.live.com/proofs/AppPassword
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Provedor do e-mail acima, se não for Gmail (padrão: gmail).
# Valores aceitos pelo Nodemailer: "yahoo", "outlook365",
# "hotmail", entre outros nomes reconhecidos nativamente.
EMAIL_SERVICE=gmail

# Nome/e-mail exibido como remetente (opcional).
# Padrão com Resend: "Notifica Vacinas <onboarding@resend.dev>"
# Padrão com SMTP: "Notifica Vacinas <EMAIL_USER>"
EMAIL_FROM=

# Expressão cron da verificação diária de pendências/agendamentos.
# Padrão: todo dia às 8h. Ex. para testar a cada 5 minutos: "*/5 * * * *"
NOTIFICACAO_CRON=0 8 * * *

# SMS ainda não tem provedor configurado (ver smsService.ts) -
# nenhuma variável necessária por enquanto.
